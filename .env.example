# Copy this file to .env. Never commit .env or credentials.
FIRECRAWL_API_KEY=
DATABASE_PATH=data/internscout.db
PROFILE_PATH=profile.json
SOURCES_PATH=sources.json
# Local caps per run. Paid Firecrawl calls are not automatically retried.
# Scheduled workflow uses 8 searches / 24 scrapes and MIN_MATCH_SCORE=80.
MAX_QUERIES=3
RESULTS_PER_QUERY=5
MAX_SCRAPES=8
MIN_MATCH_SCORE=60
RECHECK_DAYS=7

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Opportunities
GOOGLE_REJECTED_SHEET_TAB=Rejected Matches
# Option A: service-account file, shared onto the target spreadsheet as Editor
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: service-account JSON in an environment secret (preferred for Actions)
GOOGLE_CREDENTIALS_JSON=
# Option C: authorized-user OAuth JSON with a refresh token
GOOGLE_OAUTH_FILE=

# Optional, OFF by default. Deterministic matching requires no LLM.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
MAX_LLM_CALLS=0

# Hosted dashboard only: configure these as Vercel production secrets.
# Keep local mode for CLI discovery and the laptop dashboard.
# DASHBOARD_MODE=hosted
# DASHBOARD_USERNAME=internscout
# DASHBOARD_PASSWORD=<random secret of at least 24 characters>
# DASHBOARD_SECRET_KEY=<stable random secret of at least 32 characters>

# Rolling seven-day paid-request reservation cap; shared by runs using this database.
WEEKLY_CREDIT_LIMIT=400
MAX_RECHECKS=8
